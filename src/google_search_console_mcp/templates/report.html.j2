<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ t('report.document_title', site=data.site_url) }}</title>
{% if branding.font_url %}
<link rel="stylesheet" href="{{ branding.font_url }}">
{% endif %}
<style>
:root {
  --primary: {{ branding.colors.primary }};
  --primary-dark: {{ branding.colors.primary_dark }};
  --secondary: {{ branding.colors.secondary }};
  --accent: {{ branding.colors.accent }};
  --danger: {{ branding.colors.danger }};
  --warning: {{ branding.colors.warning }};
  --text: {{ branding.colors.text }};
  --text-muted: {{ branding.colors.text_muted }};
  --text-light: {{ branding.colors.text_light }};
  --bg: {{ branding.colors.bg }};
  --surface: {{ branding.colors.surface }};
  --border: {{ branding.colors.border }};
}
* { box-sizing: border-box; }
body {
  margin: 0;
  padding: 0 0 4rem;
  font-family: {{ branding.font_family }};
  color: var(--text);
  background: var(--bg);
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
}
.wrap { max-width: 1140px; margin: 0 auto; padding: 0 1.5rem; }
header.masthead {
  background: linear-gradient(135deg, var(--primary-dark), var(--primary));
  color: #fff;
  padding: 2.5rem 0 2rem;
  margin-bottom: 2rem;
}
header.masthead .brand { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.25rem; }
header.masthead img { max-height: 44px; width: auto; }
header.masthead .brand-name { font-weight: 600; letter-spacing: .02em; opacity: .9; }
header.masthead h1 { margin: 0 0 .35rem; font-size: 1.9rem; font-weight: 700; }
header.masthead .site { font-size: 1.05rem; opacity: .92; }
header.masthead .period { font-size: .92rem; opacity: .8; margin-top: .5rem; }
h2 {
  font-size: 1.3rem;
  margin: 2.5rem 0 1rem;
  padding-bottom: .5rem;
  border-bottom: 2px solid var(--border);
}
h3 { font-size: 1.05rem; margin: 1.75rem 0 .75rem; color: var(--primary-dark); }
.card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 1.25rem 1.4rem;
  margin-bottom: 1rem;
}
.kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 1rem; }
.kpi { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 1.1rem 1.2rem; }
.kpi .label { font-size: .78rem; text-transform: uppercase; letter-spacing: .06em; color: var(--text-light); }
.kpi .value { font-size: 1.85rem; font-weight: 700; margin: .3rem 0 .2rem; }
.delta { font-size: .85rem; font-weight: 600; }
.delta.positive { color: var(--accent); }
.delta.negative { color: var(--danger); }
.delta.neutral { color: var(--text-light); }
table { width: 100%; border-collapse: collapse; font-size: .88rem; }
th, td { text-align: left; padding: .5rem .6rem; border-bottom: 1px solid var(--border); vertical-align: top; }
th { font-size: .74rem; text-transform: uppercase; letter-spacing: .05em; color: var(--text-light); font-weight: 600; }
td.num, th.num { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
.url-cell { max-width: 380px; word-break: break-all; }
.table-scroll { overflow-x: auto; }
.issue { border-left: 4px solid var(--text-light); }
.issue.high { border-left-color: var(--danger); }
.issue.medium { border-left-color: var(--warning); }
.issue.low { border-left-color: var(--primary); }
.issue .meta { display: flex; gap: .5rem; align-items: center; margin-bottom: .5rem; flex-wrap: wrap; }
.badge {
  display: inline-block;
  font-size: .68rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .06em;
  padding: .18rem .5rem;
  border-radius: 999px;
  background: var(--border);
  color: var(--text-muted);
}
.badge.high { background: var(--danger); color: #fff; }
.badge.medium { background: var(--warning); color: #fff; }
.badge.low { background: var(--primary); color: #fff; }
.issue h4 { margin: 0 0 .4rem; font-size: 1.05rem; }
.issue p { margin: 0 0 .75rem; color: var(--text-muted); }
ul.strategy { margin: .5rem 0 0; padding-left: 1.15rem; color: var(--text-muted); font-size: .9rem; }
ul.strategy li { margin-bottom: .3rem; }
.chart-box { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 1rem; margin-bottom: 1rem; }
.chart-box canvas { max-height: 320px; }
.grid-2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1rem; }
.win { border-left: 4px solid var(--accent); }
.win h4 { margin: 0 0 .35rem; font-size: 1rem; }
.win p { margin: 0; color: var(--text-muted); font-size: .9rem; }
.roadmap { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem; }
.roadmap ol { margin: .5rem 0 0; padding-left: 1.15rem; font-size: .9rem; color: var(--text-muted); }
.roadmap li { margin-bottom: .4rem; }
.empty { color: var(--text-light); font-style: italic; font-size: .9rem; }
.note { font-size: .8rem; color: var(--text-light); }
footer { margin-top: 3rem; padding-top: 1.25rem; border-top: 1px solid var(--border); font-size: .8rem; color: var(--text-light); }
@media print {
  body { background: #fff; }
  .card, .kpi, .chart-box { break-inside: avoid; }
}
</style>
</head>
<body>

<header class="masthead">
  <div class="wrap">
    <div class="brand">
      {% if branding.logo_data %}<img src="{{ branding.logo_data }}" alt="{{ branding.brand_name }}">{% endif %}
      <span class="brand-name">{{ branding.brand_name }}</span>
    </div>
    <h1>{{ t('report.heading') }}</h1>
    <div class="site">{{ data.site_url }}</div>
    <div class="period">
      {{ t('report.period') }}: {{ data.date_from }} – {{ data.date_to }}
      · {{ t('report.compared_with', from=data.prev_from, to=data.prev_to) }}
    </div>
  </div>
</header>

<div class="wrap">

{% if 'overview' in sections %}
<section>
  <h2>{{ t('sections.overview') }}</h2>
  <div class="kpis">
    {% for kpi in kpis %}
    <div class="kpi">
      <div class="label">{{ kpi.label }}</div>
      <div class="value">{{ kpi.value }}</div>
      <div class="delta {% if kpi.positive is none %}neutral{% elif kpi.positive %}positive{% else %}negative{% endif %}">
        {{ kpi.delta_label }}
      </div>
    </div>
    {% endfor %}
  </div>

  <div class="grid-2" style="margin-top:1rem">
    <div class="chart-box"><canvas id="trendChart"></canvas></div>
    <div class="chart-box"><canvas id="deviceChart"></canvas></div>
  </div>

  <div class="card">
    <h3>{{ t('executive.heading') }}</h3>
    <ul class="strategy">
      {% set trend = strategy.executive.trend_pct %}
      {% if trend is none %}
        <li>{{ t('executive.trend_flat') }}</li>
      {% elif trend >= 1 %}
        <li>{{ t('executive.trend_up', pct=trend|abs|num(1)) }}</li>
      {% elif trend <= -1 %}
        <li>{{ t('executive.trend_down', pct=trend|abs|num(1)) }}</li>
      {% else %}
        <li>{{ t('executive.trend_flat') }}</li>
      {% endif %}
      <li>{{ t('executive.brand_share', pct=strategy.executive.brand_pct|num(1), non_brand_pct=strategy.executive.non_brand_pct|num(1)) }}</li>
      <li>{{ t('executive.issue_count', high=strategy.executive.high_issues, medium=strategy.executive.medium_issues) }}</li>
      {% if strategy.executive.total_uplift %}
      <li>{{ t('executive.uplift', clicks=strategy.executive.total_uplift|num) }}</li>
      {% endif %}
      {% if strategy.executive.quick_win_count %}
      <li>{{ t('executive.quick_win_count', n=strategy.executive.quick_win_count) }}</li>
      {% endif %}
    </ul>
    {% if strategy.brand.brand_terms_source == 'domain_label' %}
    <p class="note">{{ t('report.data_note', site=data.site_url) }}</p>
    {% endif %}
  </div>
</section>
{% endif %}

{% if 'issues' in sections %}
<section>
  <h2>{{ t('sections.issues') }}</h2>
  {% if not issues %}
  <p class="empty">{{ t('empty.no_issues') }}</p>
  {% endif %}
  {% for issue in issues %}
  <div class="card issue {{ issue.severity }}">
    <div class="meta">
      <span class="badge {{ issue.severity }}">{{ issue.severity_label }}</span>
      <span class="badge">{{ issue.category_label }}</span>
    </div>
    <h4>{{ issue.title }}</h4>
    <p>{{ issue.description }}</p>
    {% if issue.examples.rows %}
    <div class="table-scroll">
      {% set kind = issue.examples.type %}
      <table>
        <thead>
          <tr>
          {% if kind == 'pages' %}
            <th>{{ t('columns.url') }}</th><th class="num">{{ t('columns.clicks') }}</th><th class="num">{{ t('columns.impressions') }}</th><th class="num">{{ t('columns.position') }}</th>
          {% elif kind == 'queries' %}
            <th>{{ t('columns.query') }}</th><th class="num">{{ t('columns.impressions') }}</th><th class="num">{{ t('columns.ctr') }}</th><th class="num">{{ t('columns.position') }}</th>
          {% elif kind == 'hosts' %}
            <th>{{ t('columns.host') }}</th><th class="num">{{ t('columns.clicks') }}</th>
          {% elif kind == 'sitemaps' %}
            <th>{{ t('columns.path') }}</th><th class="num">{{ t('columns.warnings') }}</th><th class="num">{{ t('columns.errors') }}</th><th class="num">{{ t('columns.last_downloaded') }}</th>
          {% elif kind == 'indexing' %}
            <th>{{ t('columns.url') }}</th><th>{{ t('columns.verdict') }}</th><th>{{ t('columns.coverage') }}</th>
          {% elif kind == 'metric' %}
            <th>{{ t('columns.metric') }}</th><th class="num">{{ t('columns.previous') }}</th><th class="num">{{ t('columns.current') }}</th><th class="num">{{ t('columns.delta') }}</th>
          {% endif %}
          </tr>
        </thead>
        <tbody>
        {% for row in issue.examples.rows %}
          <tr>
          {% if kind == 'pages' %}
            <td class="url-cell">{{ row.url|shorten_url }}</td><td class="num">{{ row.clicks|num }}</td><td class="num">{{ row.impressions|num }}</td><td class="num">{{ row.position|pos }}</td>
          {% elif kind == 'queries' %}
            <td>{{ row.query }}</td><td class="num">{{ row.impressions|num }}</td><td class="num">{{ row.ctr|ctr }}</td><td class="num">{{ row.position|pos }}</td>
          {% elif kind == 'hosts' %}
            <td><code>{{ row.host }}</code></td><td class="num">{{ row.clicks|num }}</td>
          {% elif kind == 'sitemaps' %}
            <td><code>{{ row.path|shorten_url }}</code></td><td class="num">{{ row.warnings|num }}</td><td class="num">{{ row.errors|num }}</td><td class="num">{{ row.last_downloaded }}</td>
          {% elif kind == 'indexing' %}
            <td class="url-cell">{{ row.url|shorten_url }}</td><td><strong>{{ row.verdict }}</strong></td><td>{{ row.coverage }}</td>
          {% elif kind == 'metric' %}
            <td>{{ t('columns.' ~ row.metric) }}</td><td class="num">{{ row.previous|num }}</td><td class="num">{{ row.current|num }}</td><td class="num"><strong>{{ row.delta|signed_pct }}</strong></td>
          {% endif %}
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}
    {% if issue.strategy %}
    <ul class="strategy">
      {% for step in issue.strategy %}<li>{{ step }}</li>{% endfor %}
    </ul>
    {% endif %}
  </div>
  {% endfor %}
</section>
{% endif %}

{% if 'top_queries' in sections %}
<section>
  <h2>{{ t('sections.top_queries') }}</h2>
  <div class="card table-scroll">
    {% if data.queries %}
    <table>
      <thead><tr><th>{{ t('columns.query') }}</th><th class="num">{{ t('columns.clicks') }}</th><th class="num">{{ t('columns.impressions') }}</th><th class="num">{{ t('columns.ctr') }}</th><th class="num">{{ t('columns.position') }}</th></tr></thead>
      <tbody>
      {% for row in data.queries[:30] %}
        <tr><td>{{ row.query }}</td><td class="num">{{ row.clicks|num }}</td><td class="num">{{ row.impressions|num }}</td><td class="num">{{ row.ctr|ctr }}</td><td class="num">{{ row.position|pos }}</td></tr>
      {% endfor %}
      </tbody>
    </table>
    {% else %}<p class="empty">{{ t('empty.no_rows') }}</p>{% endif %}
  </div>
</section>
{% endif %}

{% if 'top_pages' in sections %}
<section>
  <h2>{{ t('sections.top_pages') }}</h2>
  <div class="card table-scroll">
    {% if data.pages %}
    <table>
      <thead><tr><th>{{ t('columns.page') }}</th><th class="num">{{ t('columns.clicks') }}</th><th class="num">{{ t('columns.impressions') }}</th><th class="num">{{ t('columns.ctr') }}</th><th class="num">{{ t('columns.position') }}</th></tr></thead>
      <tbody>
      {% for row in data.pages[:30] %}
        <tr><td class="url-cell">{{ row.page|shorten_url }}</td><td class="num">{{ row.clicks|num }}</td><td class="num">{{ row.impressions|num }}</td><td class="num">{{ row.ctr|ctr }}</td><td class="num">{{ row.position|pos }}</td></tr>
      {% endfor %}
      </tbody>
    </table>
    {% else %}<p class="empty">{{ t('empty.no_rows') }}</p>{% endif %}
  </div>
</section>
{% endif %}

{% if 'countries' in sections %}
<section>
  <h2>{{ t('sections.countries') }}</h2>
  <div class="card table-scroll">
    {% if data.countries %}
    <table>
      <thead><tr><th>{{ t('columns.country') }}</th><th class="num">{{ t('columns.clicks') }}</th><th class="num">{{ t('columns.impressions') }}</th><th class="num">{{ t('columns.ctr') }}</th><th class="num">{{ t('columns.position') }}</th></tr></thead>
      <tbody>
      {% for row in data.countries %}
        <tr><td>{{ row.country|upper }}</td><td class="num">{{ row.clicks|num }}</td><td class="num">{{ row.impressions|num }}</td><td class="num">{{ row.ctr|ctr }}</td><td class="num">{{ row.position|pos }}</td></tr>
      {% endfor %}
      </tbody>
    </table>
    {% else %}<p class="empty">{{ t('empty.no_rows') }}</p>{% endif %}
  </div>
</section>
{% endif %}

{% if 'sitemaps' in sections %}
<section>
  <h2>{{ t('sections.sitemaps') }}</h2>
  <div class="card table-scroll">
    {% if data.sitemaps %}
    <table>
      <thead><tr><th>{{ t('columns.path') }}</th><th class="num">{{ t('columns.warnings') }}</th><th class="num">{{ t('columns.errors') }}</th><th class="num">{{ t('columns.last_downloaded') }}</th></tr></thead>
      <tbody>
      {% for row in data.sitemaps %}
        <tr><td><code>{{ row.path|shorten_url }}</code></td><td class="num">{{ row.warnings|int|num }}</td><td class="num">{{ row.errors|int|num }}</td><td class="num">{{ row.lastDownloaded[:10] }}</td></tr>
      {% endfor %}
      </tbody>
    </table>
    {% else %}<p class="empty">{{ t('empty.no_rows') }}</p>{% endif %}
  </div>
</section>
{% endif %}

{% if 'indexing' in sections %}
<section>
  <h2>{{ t('sections.indexing') }}</h2>
  <div class="card table-scroll">
    {% if data.indexing %}
    <table>
      <thead><tr><th>{{ t('columns.url') }}</th><th>{{ t('columns.verdict') }}</th><th>{{ t('columns.coverage') }}</th></tr></thead>
      <tbody>
      {% for row in data.indexing %}
        <tr><td class="url-cell">{{ row.url|shorten_url }}</td><td><strong>{{ row.verdict }}</strong></td><td>{{ row.coverage_state }}</td></tr>
      {% endfor %}
      </tbody>
    </table>
    {% else %}<p class="empty">{{ t('empty.no_rows') }}</p>{% endif %}
  </div>
</section>
{% endif %}

{% if 'strategy' in sections %}
<section>
  <h2>{{ t('sections.strategy') }}</h2>

  <h3>{{ t('sections.quick_wins') }}</h3>
  {% if quick_wins %}
    {% for win in quick_wins %}
    <div class="card win">
      <div class="meta">
        <span class="badge">{{ t('columns.impact') }}: {{ win.impact_label }}</span>
        <span class="badge">{{ t('columns.effort') }}: {{ win.effort_label }}</span>
      </div>
      <h4>{{ win.title }}</h4>
      <p>{{ win.action }}</p>
    </div>
    {% endfor %}
  {% else %}<p class="empty">{{ t('empty.no_opportunities') }}</p>{% endif %}

  <h3>{{ t('sections.page_two') }}</h3>
  <div class="card table-scroll">
    {% if strategy.page_two_wins %}
    <table>
      <thead><tr><th>{{ t('columns.query') }}</th><th class="num">{{ t('columns.impressions') }}</th><th class="num">{{ t('columns.position') }}</th><th class="num">{{ t('columns.current_clicks') }}</th><th class="num">{{ t('columns.potential_clicks') }}</th><th class="num">{{ t('columns.uplift') }}</th></tr></thead>
      <tbody>
      {% for row in strategy.page_two_wins %}
        <tr><td>{{ row.query }}</td><td class="num">{{ row.impressions|num }}</td><td class="num">{{ row.position|pos }}</td><td class="num">{{ row.clicks|num }}</td><td class="num">{{ row.potential_clicks|num }}</td><td class="num"><strong>+{{ row.uplift|num }}</strong></td></tr>
      {% endfor %}
      </tbody>
    </table>
    {% else %}<p class="empty">{{ t('empty.no_opportunities') }}</p>{% endif %}
  </div>

  <h3>{{ t('sections.ctr_gaps') }}</h3>
  <div class="card table-scroll">
    {% if strategy.ctr_gaps %}
    <table>
      <thead><tr><th>{{ t('columns.page') }}</th><th class="num">{{ t('columns.impressions') }}</th><th class="num">{{ t('columns.ctr') }}</th><th class="num">{{ t('columns.expected_ctr') }}</th><th class="num">{{ t('columns.position') }}</th><th class="num">{{ t('columns.uplift') }}</th></tr></thead>
      <tbody>
      {% for row in strategy.ctr_gaps %}
        <tr><td class="url-cell">{{ row.page|shorten_url }}</td><td class="num">{{ row.impressions|num }}</td><td class="num">{{ row.ctr|ctr }}</td><td class="num">{{ row.expected_ctr|ctr }}</td><td class="num">{{ row.position|pos }}</td><td class="num"><strong>+{{ row.uplift|num }}</strong></td></tr>
      {% endfor %}
      </tbody>
    </table>
    {% else %}<p class="empty">{{ t('empty.no_opportunities') }}</p>{% endif %}
  </div>

  {% if strategy.traffic_drops %}
  <h3>{{ t('sections.issues') }} — {{ t('columns.diagnosis') }}</h3>
  <div class="card table-scroll">
    <table>
      <thead><tr><th>{{ t('columns.page') }}</th><th class="num">{{ t('columns.previous') }}</th><th class="num">{{ t('columns.current') }}</th><th class="num">{{ t('columns.delta') }}</th><th>{{ t('columns.diagnosis') }}</th></tr></thead>
      <tbody>
      {% for row in strategy.traffic_drops %}
        <tr><td class="url-cell">{{ row.page|shorten_url }}</td><td class="num">{{ row.prev_clicks|num }}</td><td class="num">{{ row.clicks|num }}</td><td class="num"><strong>{{ row.clicks_delta_pct|signed_pct }}</strong></td><td>{{ t('diagnosis.' ~ row.diagnosis) }}</td></tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}

  {% if strategy.themes %}
  <h3>{{ t('sections.themes') }}</h3>
  <div class="card table-scroll">
    <table>
      <thead><tr><th>{{ t('columns.theme') }}</th><th class="num">{{ t('columns.clicks') }}</th><th class="num">{{ t('columns.impressions') }}</th><th class="num">{{ t('columns.query_count') }}</th></tr></thead>
      <tbody>
      {% for row in strategy.themes %}
        <tr><td>{{ row.theme }}</td><td class="num">{{ row.clicks|num }}</td><td class="num">{{ row.impressions|num }}</td><td class="num">{{ row.query_count|num }}</td></tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}

  {% if strategy.cannibalization %}
  <h3>{{ t('sections.cannibalization') }}</h3>
  {% for group in strategy.cannibalization %}
  <div class="card">
    <h4>{{ group.query }}</h4>
    <p class="note">{{ group.page_count }} — {{ group.clicks|num }} {{ t('columns.clicks')|lower }}</p>
    <div class="table-scroll">
      <table>
        <thead><tr><th>{{ t('columns.page') }}</th><th class="num">{{ t('columns.clicks') }}</th><th class="num">{{ t('columns.impressions') }}</th><th class="num">{{ t('columns.position') }}</th></tr></thead>
        <tbody>
        {% for page in group.pages %}
          <tr><td class="url-cell">{{ page.page|shorten_url }}</td><td class="num">{{ page.clicks|num }}</td><td class="num">{{ page.impressions|num }}</td><td class="num">{{ page.position|pos }}</td></tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
  {% endfor %}
  {% endif %}

  {% if strategy.questions %}
  <h3>{{ t('sections.questions') }}</h3>
  <div class="card table-scroll">
    <table>
      <thead><tr><th>{{ t('columns.query') }}</th><th class="num">{{ t('columns.impressions') }}</th><th class="num">{{ t('columns.ctr') }}</th><th class="num">{{ t('columns.position') }}</th></tr></thead>
      <tbody>
      {% for row in strategy.questions %}
        <tr><td>{{ row.query }}</td><td class="num">{{ row.impressions|num }}</td><td class="num">{{ row.ctr|ctr }}</td><td class="num">{{ row.position|pos }}</td></tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}

  {% if strategy.device_insights %}
  <h3>{{ t('sections.devices') }}</h3>
  <div class="card">
    <table>
      <tbody>
        <tr><td>{{ t('device.mobile') }}</td><td class="num">{{ strategy.device_insights.mobile_position|pos }}</td></tr>
        <tr><td>{{ t('device.desktop') }}</td><td class="num">{{ strategy.device_insights.desktop_position|pos }}</td></tr>
        <tr><td>{{ t('device.gap') }}</td><td class="num"><strong>{{ strategy.device_insights.gap|pos }}</strong></td></tr>
        <tr><td>{{ t('device.mobile_share') }}</td><td class="num">{{ strategy.device_insights.mobile_share|num(1) }}%</td></tr>
      </tbody>
    </table>
    {% if strategy.device_insights.has_gap %}<p class="note">{{ t('device.has_gap') }}</p>{% endif %}
  </div>
  {% endif %}

  {% if strategy.geo_opportunities %}
  <h3>{{ t('sections.geo') }}</h3>
  <div class="card table-scroll">
    <table>
      <thead><tr><th>{{ t('columns.country') }}</th><th class="num">{{ t('columns.clicks') }}</th><th class="num">{{ t('columns.impressions') }}</th><th class="num">{{ t('columns.ctr') }}</th><th class="num">{{ t('columns.position') }}</th></tr></thead>
      <tbody>
      {% for row in strategy.geo_opportunities %}
        <tr><td>{{ row.country }}</td><td class="num">{{ row.clicks|num }}</td><td class="num">{{ row.impressions|num }}</td><td class="num">{{ row.ctr|ctr }}</td><td class="num">{{ row.position|pos }}</td></tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}
</section>
{% endif %}

{% if 'roadmap' in sections %}
<section>
  <h2>{{ t('sections.roadmap') }}</h2>
  <div class="roadmap">
    {% for horizon in ['30', '60', '90'] %}
    <div class="card">
      <h4>{{ t('roadmap.' ~ horizon) }}</h4>
      <ol>
        {% for step in roadmap.get(horizon, []) %}<li>{{ step }}</li>{% endfor %}
      </ol>
    </div>
    {% endfor %}
  </div>
</section>
{% endif %}

<footer>
  <p>{{ t('report.footer') }}</p>
  <p>{{ t('report.data_note', site=data.site_url) }} mcp-google-search-console {{ version }}</p>
</footer>

</div>

<script>{{ chart_js }}</script>
<script>
(function () {
  var charts = {{ charts }};
  var text = '{{ branding.colors.text_muted }}';
  var grid = '{{ branding.colors.border }}';
  if (typeof Chart === 'undefined') { return; }
  Chart.defaults.color = text;
  Chart.defaults.borderColor = grid;
  Chart.defaults.font.family = {{ branding.font_family|tojson }};

  var trend = document.getElementById('trendChart');
  if (trend && charts.trend_labels.length) {
    new Chart(trend, {
      type: 'line',
      data: {
        labels: charts.trend_labels,
        datasets: [
          { label: {{ t('kpi.clicks')|tojson }}, data: charts.trend_clicks, borderColor: '{{ branding.colors.primary }}', backgroundColor: '{{ branding.colors.primary }}22', fill: true, tension: 0.3, yAxisID: 'y' },
          { label: {{ t('kpi.impressions')|tojson }}, data: charts.trend_impressions, borderColor: '{{ branding.colors.secondary }}', backgroundColor: 'transparent', tension: 0.3, yAxisID: 'y1' }
        ]
      },
      options: {
        responsive: true,
        interaction: { mode: 'index', intersect: false },
        scales: {
          y: { position: 'left', beginAtZero: true },
          y1: { position: 'right', beginAtZero: true, grid: { drawOnChartArea: false } }
        }
      }
    });
  }

  var device = document.getElementById('deviceChart');
  if (device && charts.device_labels.length) {
    new Chart(device, {
      type: 'bar',
      data: {
        labels: charts.device_labels,
        datasets: [{ label: {{ t('kpi.clicks')|tojson }}, data: charts.device_clicks, backgroundColor: '{{ branding.colors.primary }}' }]
      },
      options: { responsive: true, scales: { y: { beginAtZero: true } } }
    });
  }
})();
</script>
</body>
</html>
